(version 1)

# GENERATED by 03_src/generate_rules.py from 03_src/rules/nets.yaml.
# Never hand-edit; edit nets.yaml and regenerate.

(rule "width_feedback"
  (condition "A.NetClass == 'FEEDBACK'")
  (constraint track_width (min 0.2mm)))

(rule "width_pwr_5v"
  (condition "A.NetClass == 'PWR_5V'")
  (constraint track_width (min 0.3mm)))

(rule "width_pwr_input"
  (condition "A.NetClass == 'PWR_INPUT'")
  (constraint track_width (min 0.5mm)))

(rule "width_switch_node"
  (condition "A.NetClass == 'SWITCH_NODE'")
  (constraint track_width (min 0.5mm)))

(rule "width_usb_signal"
  (condition "A.NetClass == 'USB_SIGNAL'")
  (constraint track_width (min 0.2mm)))

(rule "width_pwr_input_en_tap_a"
  (condition "A.NetClass == 'PWR_INPUT' && A.intersectsArea('EN_TAP_A')")
  (constraint track_width (min 0.2mm)))

(rule "width_pwr_input_en_tap_c"
  (condition "A.NetClass == 'PWR_INPUT' && A.intersectsArea('EN_TAP_C')")
  (constraint track_width (min 0.2mm)))

(rule "unnetted mechanical pads exempt"
  (condition "A.NetName == ''")
  (constraint clearance (min 0mm)))
