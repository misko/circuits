  (text "1. POWER ENTRY: 5V/2A barrel -> polyfuse -> reverse PFET -> 5VP (TVS+bulk)   [ADR-0001, spec 7.1/7.3]" (at 13.97 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "96a7058a-318b-4e9d-a7d3-3b3c39bcfd95"))
  (text "2. RAILS: AMS1117-3.3 logic rail; ferrite-filtered 3V3A analog; VSYS OR-feed   [ADR-0005, spec 7.2]" (at 212.09 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "458de483-3174-4327-a5dd-593cb2c38eec"))
  (text "3. HW WATCHDOG + COIL-RAIL GATING: 3 independent locks, all-off default   [ADR-0003, spec 6.5/7.4]" (at 406.40 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "6833ac4d-dacd-4777-841c-625b4c45a516"))
  (text "4. RELAY COIL DRIVE: GP11/12/13 -> 2x 74HC595 -> 2x ULN2803A -> 16 coils   [spec 6.4]" (at 598.17 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "15b9d265-d1f1-433d-840c-8c7f2b419607"))
  (text "5. REED RELAY BANK + J11 (ISOLATED KEYPAD ZONE, >=6mm creepage, milled slots)   [ADR-0002, spec 6.2/6.3/8.4]" (at 13.97 130.07 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "a0e32351-4d7b-406f-84e4-cdd6461b8a04"))
  (text "6. PICO 2 MODULE (pluggable, 2x 1x20 sockets; USB CDC exits to Pi 5)   [spec 2.2/5]" (at 224.79 130.07 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "6b2597c8-974f-4598-b483-9ebf2935a6dd"))
