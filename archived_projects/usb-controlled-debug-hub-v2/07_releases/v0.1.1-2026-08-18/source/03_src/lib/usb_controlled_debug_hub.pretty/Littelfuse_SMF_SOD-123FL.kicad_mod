(footprint "Littelfuse_SMF_SOD-123FL"
  (version 20240108)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Littelfuse SMF series SOD-123FL; manufacturer mounting pad layout 1.6 x 1.4 mm with 1.3 mm inner gap")
  (tags "Littelfuse SMF SOD-123FL TVS diode")
  (property "LCSC Part" "C207257")
  (attr smd)
  (fp_line (start -2.25 -1.15) (end 2.25 -1.15)
    (stroke (width 0.15) (type default)) (layer "F.SilkS"))
  (fp_line (start -2.25 1.15) (end 2.25 1.15)
    (stroke (width 0.15) (type default)) (layer "F.SilkS"))
  (fp_line (start -1.75 -1.15) (end -1.75 1.15)
    (stroke (width 0.2) (type default)) (layer "F.Fab"))
  (fp_rect (start -1.95 -1.45) (end 1.95 1.45)
    (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
  (fp_rect (start -2.5 -1.7) (end 2.5 1.7)
    (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_text reference "REF**" (at 0 -2.15 0) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "SMF16A" (at 0 2.15 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "${REFERENCE}" (at 0 0 0) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (pad "1" smd rect (at -1.45 0) (size 1.6 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 1.45 0) (size 1.6 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
  (model "${KICAD10_3DMODEL_DIR}/Diode_SMD.3dshapes/D_SOD-123F.step"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
