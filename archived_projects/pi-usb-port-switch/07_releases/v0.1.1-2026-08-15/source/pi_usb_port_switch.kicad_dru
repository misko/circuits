(version 1)
(rule "USB_SS_width"
  (condition "A.NetClass == 'USB_SS'")
  (constraint track_width (min 0.18mm)))
(rule "USB_HS_width"
  (condition "A.NetClass == 'USB_HS'")
  (constraint track_width (min 0.18mm)))
(rule "PWR_INPUT_width"
  (condition "A.NetClass == 'PWR_INPUT'")
  (constraint track_width (min 2.5mm)))
(rule "PWR_PORT_width"
  (condition "A.NetClass == 'PWR_PORT'")
  (constraint track_width (min 0.5mm)))
(rule "PWR_3V3_width"
  (condition "A.NetClass == 'PWR_3V3'")
  (constraint track_width (min 0.4mm)))
(rule "GPIO_CONTROL_width"
  (condition "A.NetClass == 'GPIO_CONTROL'")
  (constraint track_width (min 0.18mm)))
(rule "GND_RETURN_width"
  (condition "A.NetClass == 'GND_RETURN'")
  (constraint track_width (min 0.3mm)))
(rule "scoped_u2_3v3_pin1_neck"
  (condition "A.insideArea('u2_3v3_pin1_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.35mm)))
(rule "scoped_u8_3v3_pin1_neck"
  (condition "A.insideArea('u8_3v3_pin1_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.35mm)))
(rule "scoped_u14_3v3_pin1_neck"
  (condition "A.insideArea('u14_3v3_pin1_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.35mm)))
(rule "scoped_u20_3v3_pin1_neck"
  (condition "A.insideArea('u20_3v3_pin1_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.35mm)))
(rule "scoped_u2_3v3_pin13_neck"
  (condition "A.insideArea('u2_3v3_pin13_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.349mm)))
(rule "scoped_u8_3v3_pin13_neck"
  (condition "A.insideArea('u8_3v3_pin13_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.349mm)))
(rule "scoped_u14_3v3_pin13_neck"
  (condition "A.insideArea('u14_3v3_pin13_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.349mm)))
(rule "scoped_u20_3v3_pin13_neck"
  (condition "A.insideArea('u20_3v3_pin13_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.349mm)))
(rule "scoped_u3_3v3_pin10_neck"
  (condition "A.insideArea('u3_3v3_pin10_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.29mm)))
(rule "scoped_u9_3v3_pin10_neck"
  (condition "A.insideArea('u9_3v3_pin10_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.29mm)))
(rule "scoped_u15_3v3_pin10_neck"
  (condition "A.insideArea('u15_3v3_pin10_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.29mm)))
(rule "scoped_u21_3v3_pin10_neck"
  (condition "A.insideArea('u21_3v3_pin10_neck') && (A.NetName == '3V3')")
  (constraint track_width (min 0.29mm)))
(rule "scoped_u7_3v3_pin5_escape"
  (condition "A.insideArea('u7_3v3_pin5_escape') && (A.NetName == '3V3')")
  (constraint track_width (min 0.18mm)))
(rule "scoped_u25_3v3_pin5_escape"
  (condition "A.insideArea('u25_3v3_pin5_escape') && (A.NetName == '3V3')")
  (constraint track_width (min 0.18mm)))
