  (text "1. 5V ENTRY + PROTECTION: barrel(pop) / terminal(DNP); PTC+TVS+revFET  [ADR-0002, D4]" (at 13.97 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "3f5149c2-09b1-4061-a1f1-20780c844731"))
  (text "2. BUCK 3V3 (AP61102): VO=0.6(1+68/15)=3.32V; EN=5V always-on  [XMOS ref U16]" (at 181.61 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "b3f6b767-7a07-4c88-a3c7-e9054dcfc908"))
  (text "3. BUCK 0V9 core (AP61102): VO=0.6(1+10/20)=0.9V; EN<-3V3 PG (seq)  [XMOS ref U17]" (at 334.01 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "8be8ba07-08e4-40bf-bd38-431964e5dc47"))
  (text "4. LDO 1V8 (TCR2LF18 <-3V3) + LDO 3V3A (XC6227 <-5V, quiet analog)  [XMOS ref U18/U15]" (at 495.30 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "bdd3afff-a5e8-4946-9128-c8e15074bc8b"))
  (text "5. XU316-1024-TQ128 xcore.ai: APLL MCLK master, TDM master, async UAC2  [ADR-0003/0006]" (at 665.48 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "f8bc42b6-89ea-46e6-9be8-d03f2b50e23d"))
  (text "6. XU316 decoupling: 12x100n VDD, per-VDDIO 100n, bulk 10u; PLL_AVDD FB+1u  [part.yaml H.2]" (at 836.93 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "4f4f6c2a-9a18-4783-869f-8a42f8b644f2"))
  (text "7. 24MHz crystal (FA-238): Rf 1M, Rd 680R, CL 18pF (USB clock, §7.3 p19)" (at 1014.73 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "b8555965-fe1f-49c7-a2d0-8a8c4f990511"))
  (text "8. QSPI boot flash (W25Q16): CS_N pull-up 10k to 3V3 (Fig 12 p22)" (at 13.97 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "6c657a9f-4a14-4650-8e26-10872b795a6a"))
  (text "9. USB-C device (USB4105) + ESD (TPD4EUSB30) + CC Rd + VBUS sense  [§11.1/§14.1]" (at 143.51 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "312f3d0d-300a-4010-b843-ee585cbd3b06"))
  (text "10. MCLK buffer (NC7NZ34) fanout to both ADCs; BCLK/LRCK 33R source term  [§3 clocks]" (at 300.99 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "34f216e6-fc9d-43f2-bcb2-472fb54fa630"))
  (text "11. RST_N RC (10k->1V8, 10n) + I2C 4k7 pull-ups + SHT40 T/RH  [§2 reset, §7]" (at 468.63 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "ea209bc4-5971-4138-bbe5-af3a6e6b7e90"))
  (text "12. ADC1 PCM1865 (ch1-4, I2C 0x4A) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 619.76 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "741c8048-5175-4aa0-8444-79d32ed81cd8"))
  (text "13. ADC2 PCM1865 (ch5-8, I2C 0x4B) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 787.40 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "a7595b1f-1813-43c4-abbe-40df6c695678"))
  (text "14. ADC INPUT COUPLING (8x): AUD_Pn/Nn -> 1u -> 49R9 -> PCM1865 diff pair" (at 953.77 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "45a13d1c-f479-4e3a-aafc-47d52c4c7045"))
  (text "15. SKEW INJECTION HEADER (J10): INJ -> 1u -> INJ_C -> 1k into ch4 & ch8  [D7, §5A]" (at 13.97 514.88 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "ad680027-c0f5-43e8-8355-44022c0b0e73"))
