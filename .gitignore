__pycache__/
*.pyc
.easyeda_cache/
projects/*/.easyeda_cache/

# local agent worktrees / session state
.claude/

# KiCad advisory lock files. kicad-cli/pcbnew CREATE these merely by OPENING a
# board, so they appear under 04_kicad/ and — because a release's own DRC and
# export steps open the staged copy — inside sealed 07_releases/*/source/ too.
# Eleven were found strewn across the fleet 2026-07-31, four of them polluting
# sealed archives. They are process state, never content: same class as the
# .kicad_prl that shipped in cooksense v1.7's MANIFEST (task #45).
~*.kicad_pro.lck
*.kicad_pro.lck
*.lck

# Stitch resume state. `route_and_stitch_generic.py` must re-exec a FRESH
# INTERPRETER to cross the pcbnew Remove()/LoadBoard barrier, and carries its
# counters across in `<board>.kicad_pcb.stitch_state.json` written BESIDE the
# board — i.e. inside 04_kicad/, which is otherwise immutable. Same class as
# the .lck files above and gitignored for the same reason: process state,
# never content. Found 2026-07-31 by `contracts_audit.py --present`, on the
# day that scope landed, in two projects at once.
*.stitch_state.json

# --- secrets: API keys, never committed (added 2026-07-27) ---
.secrets/
*.env
.env
