  (text "1. 5V ENTRY + PROTECTION: barrel(pop) / terminal(DNP); PTC+TVS+revFET  [ADR-0002, D4]" (at 13.97 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "cd1186d4-6150-437a-874f-050e2f2449d9"))
  (text "2. BUCK 3V3 (AP61102): VO=0.6(1+68/15)=3.32V; EN=5V always-on  [XMOS ref U16]" (at 181.61 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "d6cd49c8-ccb9-4ac3-8e69-7033aceff99e"))
  (text "3. BUCK 0V9 core (AP61102): VO=0.6(1+10/20)=0.9V; EN<-3V3 PG (seq)  [XMOS ref U17]" (at 334.01 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "531aa444-03d9-4d19-95f1-207c4ed45906"))
  (text "4. LDO 1V8 (TCR2LF18 <-3V3) + LDO 3V3A (XC6227 <-5V, quiet analog)  [XMOS ref U18/U15]" (at 495.30 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "5a06011b-eda5-49af-a573-5b82748b8e3e"))
  (text "5. XU316-1024-TQ128 xcore.ai: APLL MCLK master, TDM master, async UAC2  [ADR-0003/0006]" (at 665.48 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "899c34b2-5561-4735-a24a-ec735498533d"))
  (text "6. XU316 decoupling: 12x100n VDD, per-VDDIO 100n, bulk 10u; PLL_AVDD FB+1u  [part.yaml H.2]" (at 836.93 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "b845bd79-9e75-4c75-8302-35ce9a508480"))
  (text "7. 24MHz crystal (FA-238): Rf 1M, Rd 680R, CL 18pF (USB clock, §7.3 p19)" (at 1014.73 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "c76e59c4-dad7-4894-8408-4fd7965da00d"))
  (text "8. QSPI boot flash (W25Q16): CS_N pull-up 10k to 3V3 (Fig 12 p22)" (at 13.97 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "b7216c31-0231-43e1-90ee-881106056c9e"))
  (text "9. USB-C device (USB4105) + ESD (TPD4EUSB30) + CC Rd + VBUS sense  [§11.1/§14.1]" (at 143.51 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "7f441185-b2b8-423b-bd7d-07354be5a3f5"))
  (text "10. MCLK buffer (NC7NZ34) fanout to both ADCs; BCLK/LRCK 33R source term  [§3 clocks]" (at 300.99 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "edf56bfb-2849-4586-9a67-7407d945ba12"))
  (text "11. RST_N RC (10k->1V8, 10n) + I2C 4k7 pull-ups + SHT40 T/RH  [§2 reset, §7]" (at 468.63 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "0e437853-4965-44be-ac3a-02b182d5b399"))
  (text "12. ADC1 PCM1865 (ch1-4, I2C 0x4A) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 619.76 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "3a382799-7b03-4541-95f0-0100231c6c6c"))
  (text "13. ADC2 PCM1865 (ch5-8, I2C 0x4B) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 787.40 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "90830195-fc8d-439f-ae64-bbaafa1289a5"))
  (text "14. ADC INPUT COUPLING (8x): AUD_Pn/Nn -> 1u -> 49R9 -> PCM1865 diff pair" (at 953.77 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "94a4fea4-0b9c-461f-a7f2-6aa301c8a923"))
  (text "15. SKEW INJECTION HEADER (J10): INJ -> 1u -> INJ_C -> 1k into ch4 & ch8  [D7, §5A]" (at 13.97 514.88 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "c3cdcd9f-2ec5-40f9-a5c2-c48d4b1227be"))
