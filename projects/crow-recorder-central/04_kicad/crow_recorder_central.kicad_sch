  (text "1. 5V ENTRY + PROTECTION: barrel(pop) / terminal(DNP); PTC+TVS+revFET  [ADR-0002, D4]" (at 13.97 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "d3d970e5-6d17-4d48-81d7-b395e2dc6523"))
  (text "2. BUCK 3V3 (AP61102): VO=0.6(1+68/15)=3.32V; EN=5V always-on  [XMOS ref U16]" (at 181.61 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "6b9cefb2-ceca-46f1-9866-071cd8fcb1a5"))
  (text "3. BUCK 0V9 core (AP61102): VO=0.6(1+10/20)=0.9V; EN<-3V3 PG (seq)  [XMOS ref U17]" (at 334.01 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "fc0683e8-dacd-46d7-b6d5-ac58cf6cf387"))
  (text "4. LDO 1V8 (TCR2LF18 <-3V3) + LDO 3V3A (XC6227 <-5V, quiet analog)  [XMOS ref U18/U15]" (at 495.30 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "1f7c7ea3-b12d-4e61-b197-2c56f80c54ea"))
  (text "5. XU316-1024-TQ128 xcore.ai: APLL MCLK master, TDM master, async UAC2  [ADR-0003/0006]" (at 665.48 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "63c7382c-ccf6-4c51-bfa2-97e04a1dbc9b"))
  (text "6. XU316 decoupling: 12x100n VDD, per-VDDIO 100n, bulk 10u; PLL_AVDD FB+1u  [part.yaml H.2]" (at 836.93 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "4f476b46-1c6a-44c6-958b-d3b7d7b6ef92"))
  (text "7. 24MHz crystal (FA-238): Rf 1M, Rd 680R, CL 18pF (USB clock, §7.3 p19)" (at 1014.73 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "d119cf7e-d77a-471c-bf48-5bb89add4390"))
  (text "8. QSPI boot flash (W25Q16): CS_N pull-up 10k to 3V3 (Fig 12 p22)" (at 13.97 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "c283f578-2f5e-46f9-924f-9386e23b3f7e"))
  (text "9. USB-C device (USB4105) + ESD (TPD4EUSB30) + CC Rd + VBUS sense  [§11.1/§14.1]" (at 143.51 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "1808937d-13df-424a-b617-370e2df5ca2f"))
  (text "10. MCLK buffer (NC7NZ34) fanout to both ADCs; BCLK/LRCK 33R source term  [§3 clocks]" (at 300.99 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "6add3f4b-ba4c-49e2-8200-ee5038e475d0"))
  (text "11. RST_N RC (10k->1V8, 10n) + I2C 4k7 pull-ups + SHT40 T/RH  [§2 reset, §7]" (at 468.63 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "58f32303-d03a-4816-b703-6d0ab62dbcf5"))
  (text "12. ADC1 PCM1865 (ch1-4, I2C 0x4A) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 619.76 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "ce60d852-7335-40da-becf-0b190186114f"))
  (text "13. ADC2 PCM1865 (ch5-8, I2C 0x4B) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 787.40 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "190ae150-7875-4343-ac9c-6b5f0ea3390f"))
  (text "14. ADC INPUT COUPLING (8x): AUD_Pn/Nn -> 1u -> 49R9 -> PCM1865 diff pair" (at 953.77 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "d8c8c56b-5e45-41a0-99e1-5242c1176d07"))
  (text "15. SKEW INJECTION HEADER (J10): INJ -> 1u -> INJ_C -> 1k into ch4 & ch8  [D7, §5A]" (at 13.97 514.88 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "21e9ff1c-4dbe-41be-a888-97f4e87fa2c1"))
