(version 1)
(rule "RF_50R_width"
  (condition "A.NetClass == 'RF_50R'")
  (constraint track_width (min 0.295mm)))
(rule "USB_VBUS_width"
  (condition "A.NetClass == 'USB_VBUS'")
  (constraint track_width (min 0.3mm)))
(rule "PWR_3V3_width"
  (condition "A.NetClass == 'PWR_3V3'")
  (constraint track_width (min 0.25mm)))
(rule "TYPEC_CC_width"
  (condition "A.NetClass == 'TYPEC_CC'")
  (constraint track_width (min 0.18mm)))
(rule "CONTROL_width"
  (condition "A.NetClass == 'CONTROL'")
  (constraint track_width (min 0.18mm)))
(rule "GROUND_width"
  (condition "A.NetClass == 'GROUND'")
  (constraint track_width (min 0.25mm)))
