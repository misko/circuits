  (text "1. POWER ENTRY: 5V/2A barrel -> polyfuse -> reverse PFET -> 5VP (TVS+bulk)   [ADR-0001, spec 7.1/7.3]" (at 13.97 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "235c5396-4653-41b9-b4b0-cb6cf0b46e51"))
  (text "2. RAILS: AMS1117-3.3 logic rail; ferrite-filtered 3V3A analog; VSYS OR-feed   [ADR-0005, spec 7.2]" (at 212.09 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "8826534b-ade1-4fac-8cdf-52f14c2c3ccd"))
  (text "3. HW WATCHDOG + COIL-RAIL GATING: 3 independent locks, all-off default   [ADR-0003, spec 6.5/7.4]" (at 406.40 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "521707f3-992f-494d-8312-4573e38c43fb"))
  (text "4. RELAY COIL DRIVE: GP11/12/13 -> 2x 74HC595 -> 2x ULN2803A -> 16 coils   [spec 6.4]" (at 598.17 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "62631551-5180-4445-85ad-54bacd7fa540"))
  (text "5. REED RELAY BANK + J11 (ISOLATED KEYPAD ZONE, >=6mm creepage, milled slots)   [ADR-0002, spec 6.2/6.3/8.4]" (at 13.97 130.07 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "452bd115-c656-42fb-b2d0-fb62343d945f"))
  (text "6. PICO 2 MODULE (pluggable, 2x 1x20 sockets; USB CDC exits to Pi 5)   [spec 2.2/5]" (at 224.79 130.07 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "74376483-ebd6-4fb0-a826-10dac35b5d2c"))
