  (text "1. POWER ENTRY: 5V/2A barrel -> polyfuse -> reverse PFET -> 5VP (TVS+bulk)   [ADR-0001, spec 7.1/7.3]" (at 13.97 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "ba9ecce2-5959-46fc-84ae-f29d1d1c09e1"))
  (text "2. RAILS: AMS1117-3.3 logic rail; ferrite-filtered 3V3A analog; VSYS OR-feed   [ADR-0005, spec 7.2]" (at 212.09 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "de512801-9d27-4e18-b1bd-da1664fc9c4e"))
  (text "3. HW WATCHDOG + COIL-RAIL GATING: 3 independent locks, all-off default   [ADR-0003, spec 6.5/7.4]" (at 406.40 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "f395bc9f-2582-4335-89a6-4acf3712cbdf"))
  (text "4. RELAY COIL DRIVE: GP11/12/13 -> 2x 74HC595 -> 2x ULN2803A -> 16 coils   [spec 6.4]" (at 598.17 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "0b26409b-266d-4600-adab-603adad431a4"))
  (text "5. REED RELAY BANK + J11 (ISOLATED KEYPAD ZONE, >=6mm creepage, milled slots)   [ADR-0002, spec 6.2/6.3/8.4]" (at 13.97 130.07 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "669259e0-ad14-4315-b09c-0bf3ae855425"))
  (text "6. PICO 2 MODULE (pluggable, 2x 1x20 sockets; USB CDC exits to Pi 5)   [spec 2.2/5]" (at 224.79 130.07 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "38f4294a-edfb-4df9-88b6-af707845a41a"))
