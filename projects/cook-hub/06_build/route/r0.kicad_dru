(rule width_keypad
  (condition "A.NetClass == 'KEYPAD'")
  (constraint track_width (min 0.40mm)))
(rule width_coil
  (condition "A.NetClass == 'COIL'")
  (constraint track_width (min 0.40mm)))
(rule width_pwr
