  (text "1. 5V ENTRY + PROTECTION: barrel(pop) / terminal(DNP); PTC+TVS+revFET  [ADR-0002, D4]" (at 13.97 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "0db55b38-e7c1-4088-bd9b-b6de6fae69c7"))
  (text "2. BUCK 3V3 (AP61102): VO=0.6(1+68/15)=3.32V; EN=5V always-on  [XMOS ref U16]" (at 181.61 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "178f4d6c-0218-44cc-8c7d-bdd729c919cc"))
  (text "3. BUCK 0V9 core (AP61102): VO=0.6(1+10/20)=0.9V; EN<-3V3 PG (seq)  [XMOS ref U17]" (at 334.01 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "76c7b49e-e3ea-4d38-99c9-45cb6191a0f5"))
  (text "4. LDO 1V8 (TCR2LF18 <-3V3) + LDO 3V3A (XC6227 <-5V, quiet analog)  [XMOS ref U18/U15]" (at 495.30 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "3168e19d-b8f2-4986-99b2-537a1417cce6"))
  (text "5. XU316-1024-TQ128 xcore.ai: APLL MCLK master, TDM master, async UAC2  [ADR-0003/0006]" (at 665.48 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "f812b9b1-20fd-4487-b4af-52db1962857f"))
  (text "6. XU316 decoupling: 12x100n VDD, per-VDDIO 100n, bulk 10u; PLL_AVDD FB+1u  [part.yaml H.2]" (at 836.93 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "56ad7471-db83-47df-9813-7b56fb80f710"))
  (text "7. 24MHz crystal (FA-238): Rf 1M, Rd 680R, CL 18pF (USB clock, §7.3 p19)" (at 1014.73 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "19944c51-96db-4835-af87-05f56511cbf6"))
  (text "8. QSPI boot flash (W25Q16): CS_N pull-up 10k to 3V3 (Fig 12 p22)" (at 13.97 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "79600192-9727-4307-8760-2dcd2fc9bad6"))
  (text "9. USB-C device (USB4105) + ESD (TPD4EUSB30) + CC Rd + VBUS sense  [§11.1/§14.1]" (at 143.51 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "db28db2f-855a-47de-ae5b-e25163af034c"))
  (text "10. MCLK buffer (NC7NZ34) fanout to both ADCs; BCLK/LRCK 33R source term  [§3 clocks]" (at 300.99 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "e59fd11a-3ffb-4213-b06b-7f2b6944b292"))
  (text "11. RST_N RC (10k->1V8, 10n) + I2C 4k7 pull-ups + SHT40 T/RH  [§2 reset, §7]" (at 468.63 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "74928754-a333-495a-bad5-87231e111c9d"))
  (text "12. ADC1 PCM1865 (ch1-4, I2C 0x4A) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 619.76 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "5f85d03a-e02f-43b8-8541-58d8f1c766e1"))
  (text "13. ADC2 PCM1865 (ch5-8, I2C 0x4B) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 787.40 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "f64ed7d8-a2b2-4b96-aeb2-9d092baa6333"))
  (text "14. ADC INPUT COUPLING (8x): AUD_Pn/Nn -> 1u -> 49R9 -> PCM1865 diff pair" (at 953.77 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "cf42fede-39ec-43f5-b40e-7c5a47b6d0a6"))
  (text "15. SKEW INJECTION HEADER (J10): INJ -> 1u -> INJ_C -> 1k into ch4 & ch8  [D7, §5A]" (at 13.97 514.88 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "335a3452-55f8-4a1b-9f37-f79720020e07"))
