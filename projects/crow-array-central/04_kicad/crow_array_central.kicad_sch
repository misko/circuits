  (text "1. 5V ENTRY + PROTECTION: barrel(pop) / terminal(DNP); PTC+TVS+revFET  [ADR-0002, D4]" (at 13.97 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "4c0a0a5b-adc8-460a-b8cc-5956bf69e212"))
  (text "2. BUCK 3V3 (AP61102): VO=0.6(1+68/15)=3.32V; EN=5V always-on  [XMOS ref U16]" (at 181.61 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "fb017447-a5dd-45f6-a52b-29641d82d9bd"))
  (text "3. BUCK 0V9 core (AP61102): VO=0.6(1+10/20)=0.9V; EN<-3V3 PG (seq)  [XMOS ref U17]" (at 334.01 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "3e3afdb8-79dc-4c1e-b324-f8dc80025956"))
  (text "4. LDO 1V8 (TCR2LF18 <-3V3) + LDO 3V3A (XC6227 <-5V, quiet analog)  [XMOS ref U18/U15]" (at 495.30 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "9a2742cf-338a-4e6c-8047-8e8251414967"))
  (text "5. XU316-1024-TQ128 xcore.ai: APLL MCLK master, TDM master, async UAC2  [ADR-0003/0006]" (at 665.48 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "d6c8a561-be10-41ba-af5e-d6beca09fd42"))
  (text "6. XU316 decoupling: 12x100n VDD, per-VDDIO 100n, bulk 10u; PLL_AVDD FB+1u  [part.yaml H.2]" (at 836.93 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "f1fbd6df-c6c5-4eeb-a798-b709b06a90d2"))
  (text "7. 24MHz crystal (FA-238): Rf 1M, Rd 680R, CL 18pF (USB clock, §7.3 p19)" (at 1014.73 15.77 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "292846f8-8319-4488-9533-44ad5d0bc115"))
  (text "8. QSPI boot flash (W25Q16): CS_N pull-up 10k to 3V3 (Fig 12 p22)" (at 13.97 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "ea976717-e45c-4a61-9cbf-95356b149a81"))
  (text "9. USB-C device (USB4105) + ESD (TPD4EUSB30) + CC Rd + VBUS sense  [§11.1/§14.1]" (at 143.51 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "10171ed1-5653-4ce0-9b47-64ab7a4dc04a"))
  (text "10. MCLK buffer (NC7NZ34) fanout to both ADCs; BCLK/LRCK 33R source term  [§3 clocks]" (at 300.99 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "6cd9f176-e6ae-49b2-a507-b8a2eb0280a8"))
  (text "11. RST_N RC (10k->1V8, 10n) + I2C 4k7 pull-ups + SHT40 T/RH  [§2 reset, §7]" (at 468.63 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "18bf9ffd-648a-4e20-8f5a-e1960bd6eb4a"))
  (text "12. ADC1 PCM1865 (ch1-4, I2C 0x4A) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 619.76 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "ebe0b3ab-18d2-4a06-8d4e-4af6331d50cb"))
  (text "13. ADC2 PCM1865 (ch5-8, I2C 0x4B) + decoupling + GPIO 100k pulldowns  [§5, ADR-0006]" (at 787.40 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "8b8a7f3b-515c-4c33-96e0-9053d980dd49"))
  (text "14. ADC INPUT COUPLING (8x): AUD_Pn/Nn -> 1u -> 49R9 -> PCM1865 diff pair" (at 953.77 201.19 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "2d6c3db9-f4c1-41c0-8a25-eb72f5d0ac89"))
  (text "15. SKEW INJECTION HEADER (J10): INJ -> 1u -> INJ_C -> 1k into ch4 & ch8  [D7, §5A]" (at 13.97 514.88 0) (effects (font (size 2.0 2.0) bold) (justify left)) (uuid "df948f90-4d1f-45a9-a8b8-e69bbb77008a"))
