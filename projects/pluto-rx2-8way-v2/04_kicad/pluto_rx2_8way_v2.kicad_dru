(version 1)
(rule "RF50_width"
  (condition "A.NetClass == 'RF50'")
  (constraint track_width (min 0.36mm)))
(rule "CTRL_width"
  (condition "A.NetClass == 'CTRL'")
  (constraint track_width (min 0.2mm)))
(rule "PWR_width"
  (condition "A.NetClass == 'PWR'")
  (constraint track_width (min 0.4mm)))
(rule "scoped_clr_rf_launch"
  (condition "A.insideArea('rf_launch') && B.insideArea('rf_launch') && (A.NetName == 'ANT1' || B.NetName == 'ANT1' || A.NetName == 'ANT2' || B.NetName == 'ANT2' || A.NetName == 'ANT3' || B.NetName == 'ANT3' || A.NetName == 'ANT4' || B.NetName == 'ANT4' || A.NetName == 'ANT5' || B.NetName == 'ANT5' || A.NetName == 'ANT6' || B.NetName == 'ANT6' || A.NetName == 'ANT7' || B.NetName == 'ANT7' || A.NetName == 'RX2_OUT' || B.NetName == 'RX2_OUT' || A.NetName == 'RX1_TAP' || B.NetName == 'RX1_TAP' || A.NetName == '3V3' || B.NetName == '3V3')")
  (constraint clearance (min 0.14mm)))
(rule "scoped_clr_ctrl_escape"
  (condition "A.insideArea('ctrl_escape') && B.insideArea('ctrl_escape') && (A.NetName == 'SW_V1' || B.NetName == 'SW_V1' || A.NetName == 'SW_V2' || B.NetName == 'SW_V2' || A.NetName == 'SW_V3' || B.NetName == 'SW_V3' || A.NetName == 'SW_V4' || B.NetName == 'SW_V4')")
  (constraint clearance (min 0.14mm)))
(rule pad_rescue_stubs
  (condition "A.insideArea('pad_rescue_stubs') && (A.NetName == 'GND')")
  (constraint track_width (min 0.300mm)))
