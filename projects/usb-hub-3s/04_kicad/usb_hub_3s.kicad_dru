(version 1)
(rule "SWITCH_NODE_width"
  (condition "A.NetClass == 'SWITCH_NODE'")
  (constraint track_width (min 1.0mm)))
(rule "PWR_IN_width"
  (condition "A.NetClass == 'PWR_IN'")
  (constraint track_width (min 0.8mm)))
(rule "PWR_RAIL_width"
  (condition "A.NetClass == 'PWR_RAIL'")
  (constraint track_width (min 0.8mm)))
(rule "VBUS_width"
  (condition "A.NetClass == 'VBUS'")
  (constraint track_width (min 0.8mm)))
(rule "GATE_width"
  (condition "A.NetClass == 'GATE'")
  (constraint track_width (min 0.3mm)))
(rule "SENSE_width"
  (condition "A.NetClass == 'SENSE'")
  (constraint track_width (min 0.2mm)))
(rule "USB_DATA_width"
  (condition "A.NetClass == 'USB_DATA'")
  (constraint track_width (min 0.19mm)))
(rule "AUX_5V_width"
  (condition "A.NetClass == 'AUX_5V'")
  (constraint track_width (min 0.24mm)))
(rule "NC_PADS_width"
  (condition "A.NetClass == 'NC_PADS'")
  (constraint track_width (min 0.2mm)))
(rule "GND_RET_width"
  (condition "A.NetClass == 'GND_RET'")
  (constraint track_width (min 0.25mm)))
(rule "scoped_pd_sense"
  (condition "A.insideArea('pd_sense') && (A.NetName == 'LX1' || A.NetName == 'LX2' || A.NetName == 'VOUT_PD' || A.NetName == 'VOUT_PDS' || A.NetName == 'VIN' || A.NetName == 'VIN_S')")
  (constraint track_width (min 0.19mm)))
(rule "scoped_sw_sense"
  (condition "A.insideArea('sw_sense') && (A.NetName == 'SW_A' || A.NetName == '5VA')")
  (constraint track_width (min 0.3mm)))
(rule "scoped_pd_sense_"
  (condition "A.insideArea('pd_sense') && (A.NetName == 'HG1' || A.NetName == 'HG2' || A.NetName == 'LG1' || A.NetName == 'LG2' || A.NetName == 'BST1' || A.NetName == 'BST2' || A.NetName == 'PATH_G')")
  (constraint track_width (min 0.19mm)))
(rule "scoped_vconn_feed"
  (condition "A.insideArea('vconn_feed') && (A.NetName == '5VA')")
  (constraint track_width (min 0.4mm)))
(rule "scoped_port_bond"
  (condition "A.insideArea('port_bond') && (A.NetName == 'VBUSA1' || A.NetName == 'VBUSA2' || A.NetName == 'VBUSA3')")
  (constraint track_width (min 0.25mm)))
(rule "scoped_j5_bond"
  (condition "A.insideArea('j5_bond') && (A.NetName == 'VBUSC')")
  (constraint track_width (min 0.19mm)))
(rule "scoped_vbat_therm"
  (condition "A.insideArea('vbat_therm') && (A.NetName == 'VBAT_F')")
  (constraint track_width (min 0.3mm)))
(rule pad_rescue_stubs
  (condition "A.insideArea('pad_rescue_stubs') && (A.NetName == 'GND' || A.NetName == 'VIN')")
  (constraint track_width (min 0.300mm)))
