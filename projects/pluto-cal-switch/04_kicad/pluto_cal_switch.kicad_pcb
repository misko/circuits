	(footprint "pluto_cal_switch:C_0402_1005Metric_RF"
		(layer "F.Cu")
		(uuid "49a1f078-256f-4a6f-89cc-2655a6c371b2")
		(at 44 64.25)
		(descr "RF-MINIMUM-AREA 0402 (1005 metric) land for CL05C102JB5NNNC (1 nF C0G antenna-port DC block, C307441). IPC-7351B LEAST (density level C): pad 0.46 x 0.51 mm at x=+/-0.45, gap 0.44 mm - NOT the IPC-NOMINAL 0.54 x 0.64 at +/-0.51 that KiCad's stock Capacitor_SMD:C_0402_1005Metric carries. -32% pad area = -0.0206 pF of shunt capacitance to the L2 plane per pad on the 0.2104 mm 7628 prepreg (638 vs 415 ohm at 6 GHz against a 50 ohm line). Use ONLY on parts that sit in the 50 ohm path; every other 0402 on this board uses the stock nominal land.")
