(version 1)
(rule "RF50_width"
  (condition "A.NetClass == 'RF50'")
  (constraint track_width (min 0.35mm)))
(rule "RF_LOOP_MATCH_width"
  (condition "A.NetClass == 'RF_LOOP_MATCH'")
  (constraint track_width (min 0.35mm)))
(rule "USB_DP_width"
  (condition "A.NetClass == 'USB_DP'")
  (constraint track_width (min 0.33mm)))
(rule "CTRL_width"
  (condition "A.NetClass == 'CTRL'")
  (constraint track_width (min 0.2mm)))
(rule "QSPI_width"
  (condition "A.NetClass == 'QSPI'")
  (constraint track_width (min 0.2mm)))
(rule "PWR_width"
  (condition "A.NetClass == 'PWR'")
  (constraint track_width (min 0.4mm)))
