(version 1)
(rule "RF50_width"
  (condition "A.NetClass == 'RF50'")
  (constraint track_width (min 0.36mm)))
(rule "RF_LOOP_MATCH_width"
  (condition "A.NetClass == 'RF_LOOP_MATCH'")
  (constraint track_width (min 0.36mm)))
(rule "USB_DP_width"
  (condition "A.NetClass == 'USB_DP'")
  (constraint track_width (min 0.33mm)))
(rule "CTRL_width"
  (condition "A.NetClass == 'CTRL'")
  (constraint track_width (min 0.2mm)))
(rule "QSPI_width"
  (condition "A.NetClass == 'QSPI'")
  (constraint track_width (min 0.2mm)))
(rule "PWR_width"
  (condition "A.NetClass == 'PWR'")
  (constraint track_width (min 0.4mm)))
(rule "scoped_taper_u_sw1"
  (condition "A.insideArea('taper_u_sw1') && (A.NetName == 'RX_PLUTO1' || A.NetName == 'RF_CTRL_SW1')")
  (constraint track_width (min 0.15mm)))
(rule "scoped_taper_u_sw2"
  (condition "A.insideArea('taper_u_sw2') && (A.NetName == 'RX_PLUTO2' || A.NetName == 'RF_CTRL_SW2')")
  (constraint track_width (min 0.15mm)))
(rule "scoped_taper_u_mcu"
  (condition "A.insideArea('taper_u_mcu') && (A.NetName == '3V3' || A.NetName == 'VREG_VOUT' || A.NetName == 'USB_DP_MCU' || A.NetName == 'USB_DM_MCU')")
  (constraint track_width (min 0.25mm)))
(rule pad_rescue_stubs
  (condition "A.insideArea('pad_rescue_stubs') && (A.NetName == 'GND')")
  (constraint track_width (min 0.300mm)))
