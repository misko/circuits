(version 1)
(rule "VIN_TRUNK_width"
  (condition "A.NetClass == 'VIN_TRUNK'")
  (constraint track_width (min 1.0mm)))
(rule "PWR_5VA_width"
  (condition "A.NetClass == 'PWR_5VA'")
  (constraint track_width (min 1.0mm)))
(rule "PWR_5VC_width"
  (condition "A.NetClass == 'PWR_5VC'")
  (constraint track_width (min 1.0mm)))
(rule "PWR_PORT_width"
  (condition "A.NetClass == 'PWR_PORT'")
  (constraint track_width (min 0.8mm)))
(rule "SW_LOCAL_width"
  (condition "A.NetClass == 'SW_LOCAL'")
  (constraint track_width (min 0.3mm)))
(rule "SENSE_width"
  (condition "A.NetClass == 'SENSE'")
  (constraint track_width (min 0.18mm)))
(rule "USB_CHARGE_SIG_width"
  (condition "A.NetClass == 'USB_CHARGE_SIG'")
  (constraint track_width (min 0.18mm)))
(rule "TYPEC_CC_width"
  (condition "A.NetClass == 'TYPEC_CC'")
  (constraint track_width (min 0.18mm)))
(rule "CONTROL_width"
  (condition "A.NetClass == 'CONTROL'")
  (constraint track_width (min 0.18mm)))
(rule "scoped_u1_5va_launch"
  (condition "A.insideArea('u1_5va_launch') && (A.NetName == '5VA')")
  (constraint track_width (min 0.5mm)))
(rule "scoped_u2_5vc_launch"
  (condition "A.insideArea('u2_5vc_launch') && (A.NetName == '5VC_RAW')")
  (constraint track_width (min 0.3mm)))
(rule "scoped_usba_switch_in_launch"
  (condition "A.insideArea('usba_switch_in_launch') && (A.NetName == '5VA')")
  (constraint track_width (min 0.8mm)))
(rule "scoped_charge_signature_supply_launch"
  (condition "A.insideArea('charge_signature_supply_launch') && (A.NetName == '5VA')")
  (constraint track_width (min 0.8mm)))
(rule pad_rescue_stubs
  (condition "A.insideArea('pad_rescue_stubs') && (A.NetName == 'GND')")
  (constraint track_width (min 0.300mm)))
